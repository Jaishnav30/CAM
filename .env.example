# ==============================================================================
# CAMS Environment Variables & Database Configuration
# ==============================================================================

# PostgreSQL Database Configuration (Port 5433 mapped to container 5432)
POSTGRES_DB=cams_db
POSTGRES_USER=cams_user
POSTGRES_PASSWORD=cams_password
POSTGRES_PORT=5433
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/cams_db

# Security & Initial Admin Bootstrap (Required for initial startup)
CAMS_ADMIN_EMAIL=admin@cams.local
CAMS_ADMIN_PASSWORD=ChangeMeImmediately_Admin2026!
CAMS_JWT_SECRET=4a72d3f9e8b1c5a6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0

# Server Port Configuration
SERVER_PORT=8081

# File Storage Configuration
CAMS_STORAGE_LOCAL_BASE_PATH=./uploads

# Spring Mail Configuration (Gmail SMTP)
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password

